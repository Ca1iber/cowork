    "tilelang/language/builtin.py": {
      "sha256": "aa60be6ffa72ca294556e4e6ecf667c7febfcacc66f609b278e9d3b9c49348c9",
      "lines": {
        "969": "def shfl_sync(",
        "970": "    value: int | PrimExpr,",
        "971": "    srcLane: int | PrimExpr,",
        "972": "    width: int | PrimExpr = _DEFAULT_SHFL_WIDTH,",
        "973": "    mask: int | PrimExpr = _FULL_WARP_MASK,",
        "974": "):",
        "975": "    \"\"\"Broadcast ``value`` from ``srcLane`` to all lanes in the subgroup of",
        "976": "    ``width`` lanes (``__shfl_sync`` on CUDA, ``__shfl`` on HIP \u2014 mask ignored",
        "977": "    on HIP).",
        "978": "    \"\"\"",
        "979": "    if _IS_MACA_AVAILABLE:",
        "980": "        return tir.call_intrin(value.dtype, tir.op.Op.get(\"tl.shfl_sync\"), _as_uint64_mask(mask), value, srcLane, width)",
        "981": "    return tir.call_intrin(value.dtype, tir.op.Op.get(\"tl.shfl_sync\"), _as_uint32_mask(mask), value, srcLane, width)"
      }
    },
    "src/target/codegen_maca.cc": {
