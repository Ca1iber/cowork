      "lines": {
        "29": "TL_DEVICE int get_lane_idx(int warp_size = detail::default_warp_size()) {",
        "30": "  warp_size = warp_size > 0 ? warp_size : detail::default_warp_size();",
        "31": "  return detail::linear_thread_idx_in_block() % warp_size;",
        "32": "}",
        "33": "",
        "34": "TL_DEVICE int get_warp_idx_sync(int warp_size = detail::default_warp_size()) {",
        "35": "  warp_size = warp_size > 0 ? warp_size : detail::default_warp_size();",
        "36": "  return detail::linear_thread_idx_in_block() / warp_size;",
        "37": "}",
        "38": "",
        "39": "TL_DEVICE int get_warp_idx(int warp_size = detail::default_warp_size()) {",
        "40": "  warp_size = warp_size > 0 ? warp_size : detail::default_warp_size();",
        "41": "  return detail::linear_thread_idx_in_block() / warp_size;",
        "42": "}"
      }
