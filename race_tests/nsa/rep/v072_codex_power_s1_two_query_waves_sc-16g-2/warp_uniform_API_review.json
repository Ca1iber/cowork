      "lines": {
        "2267": "  } else if (op->op.same_as(tl::shfl_sync())) {",
        "2268": "    ICHECK_EQ(op->args.size(), 4U)",
        "2269": "        << \"tl.shfl_sync expects <mask, value, src_lane, width>.\";",
        "2270": "    os << \"__shfl_sync(\" << PrintExpr(op->args[0]) << \", \"",
        "2271": "       << PrintExpr(op->args[1]) << \", \" << PrintExpr(op->args[2]) << \", \"",
        "2272": "       << PrintExpr(op->args[3]) << \")\";"
      }
    }
